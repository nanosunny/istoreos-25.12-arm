# =====================================================================
# iStoreOS for Amlogic S9xxx (M302A / S905L3B) rootfs 配置
# 编译目标：armsr/armv8（通用 ARM64 SystemReady rootfs）
# 打包阶段：由 ophub/amlogic-s9xxx-openwrt 脚本注入 flippy/unifreq
#            定制内核（默认 6.1.y）+ DTB + bootloader，生成可写 U 盘
#            启动的 M302A 专用镜像。
# =====================================================================

# ---------- 目标平台（通用 ARM64 rootfs） ----------
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="armsr"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_DEVICE_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=512
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n

# ---------- 内核模块：通用 ARM64 + Amlogic 盒子常用 ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-sdhci=y
CONFIG_PACKAGE_kmod-mmc=y

# ---------- 网络（盒子一般单百兆口 RTL8211F 或 Fast Ethernet） ----------
CONFIG_PACKAGE_kmod-libphy=y
CONFIG_PACKAGE_kmod-of-mdio=y
CONFIG_PACKAGE_kmod-mdio-devres=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-phylink=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_kmod-stmmac=y
CONFIG_PACKAGE_kmod-stmmac-platform=y
CONFIG_PACKAGE_kmod-stmmac-pci=y
CONFIG_PACKAGE_kmod-dwmac-meson8b=y
CONFIG_PACKAGE_kmod-dwmac-meson-axg=y

# ---------- WiFi：常见 USB 网卡支持（M302A 多数批次无内置 WiFi，
#              需外接 USB 网卡，内置时按机型追加即可） ----------
CONFIG_PACKAGE_kmod-mt7601u=y
CONFIG_PACKAGE_kmod-rtl8188eu=y
CONFIG_PACKAGE_kmod-rtl8192cu=y
CONFIG_PACKAGE_kmod-rtl8812au-ct=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# ---------- 基础系统（iStoreOS 必须） ----------
CONFIG_PACKAGE_iStore-OS=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ---------- iStore 常用工具 ----------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-i18n-store-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-upgrade=y
CONFIG_PACKAGE_luci-i18n-upgrade-zh-cn=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y

# ---------- OpenAppFilter 应用过滤
# 注意：Amlogic 用的是 ophub/unifreq 的定制内核（6.1.y），
# 并非 OpenWrt 官方内核；kmod-oaf 必须与定制内核版本严格匹配，
# 直接在 make 阶段编会出不兼容模块。
# 首版仅内置 LuCI 界面与用户态工具；kmod-oaf 在镜像启动后
# 通过 luci-app-oaf 提供的内核模块在线安装功能自动匹配版本。
# （如需内置 kmod-oaf，需要把 oaf 打进 ophub 内核编译分支，后续可加）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_appfilter=y
# CONFIG_PACKAGE_kmod-oaf=n

# ---------- U 盘启动后写 eMMC 工具（ophub/flippy 通用） ----------
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_fdisk=y

# ---------- 默认语言 ----------
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
